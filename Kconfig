source "Kconfig.zephyr"

config DUST_ECAT_RTT_TRACE
    bool "Bounded DM disable RTT trace in RAM (lab only)"
    default n
    help
      Record 128 sequential CAN3 ID3 disable requests without changing PDO ABI.
      Export dust_ecat_trace through JTAG after stopping the master.


config WBR_CONTROL_ONBOARD_IMU_RAW
    bool "Acquire raw HXY onboard IMU bursts"
    default n

config WBR_CONTROL_ONBOARD_IMU_SPI_FREQUENCY_HZ
    int "Onboard IMU SPI frequency"
    default 8000000
    range 100000 24000000
    depends on WBR_CONTROL_ONBOARD_IMU_RAW

config DUST_DMA_BUFFER_ALIGNMENT
    int "DMA buffer alignment in bytes (power of two)"
    default 4
    range 4 4096

config DUST_BOARD_OUTPUTS
    bool "Board LEDs, buzzer and IMU heater"
    depends on PWM && GPIO
    default n

config DUST_IMU_HEATER_ENABLE
    bool "Enable IMU heater output (requires bench tuning)"
    depends on DUST_BOARD_OUTPUTS
    default n

config DUST_IMU_TARGET_C
    int "IMU target temperature in Celsius"
    default 45
    range 25 50

config DUST_IMU_HEATER_KP_MILLI
    int "Heater proportional gain, multiplied by 1000"
    default 100
    range 0 1000

config DUST_IMU_HEATER_KI_MILLI
    int "Heater integral gain, multiplied by 1000"
    default 5
    range 0 1000

config DUST_IMU_HEATER_KD_MILLI
    int "Heater derivative gain, multiplied by 1000"
    default 0
    range 0 1000

config DUST_IMU_HEATER_MAX_PERMILLE
    int "Maximum heater duty in permille"
    default 1000
    range 0 1000

config DUST_ECAT_ESC_DMA
    bool "Synchronous ESC PDO DMA experiment"
    depends on BOARD_DUST_HPM5E31 && DMA
    default n
    help
      Use a reserved XDMA channel and uncached staging buffer for aligned PDO
      blocks. Wait for completion; fail closed on DMA errors or 500 us timeout.
      Register/mailbox and IRQ-context accesses keep the CPU path.

config DUST_ECAT_CAN_RX_THREAD
    bool "Event-driven CAN receive worker"
    depends on MULTITHREADING
    default y
    help
      Priority 0 worker drains bounded CAN queues on IRQ semaphore wakeups.
      SSC/Core remain on main priority 1 and consume a separately copied snapshot.
      Disable for the single-thread RTT control experiment.

config DUST_ECAT_CAN_RX_POLL_US
    int "CAN RX worker fallback polling interval (0 = events only)"
    depends on DUST_ECAT_CAN_RX_THREAD
    default 100
    range 0 20000
    help
      CAN IRQs always signal immediately. Zero blocks until an event. The SSC
      owner expires retained snapshots before publishing, so expiry does not
      require periodic high-priority worker wakeups. Use 100 as the control.

config DUST_ECAT_SCHED_STATS
    bool "Bounded CAN worker wakeup counters in RAM (lab only)"
    depends on DUST_ECAT_CAN_RX_THREAD
    default n
