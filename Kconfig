source "Kconfig.zephyr"

config ONBOARD_IMU_RAW
    bool "Acquire raw HXY onboard IMU bursts"
    default n

config ONBOARD_IMU_SPI_FREQUENCY_HZ
    int "Onboard IMU SPI frequency"
    default 8000000
    range 100000 24000000
    depends on ONBOARD_IMU_RAW

config DMA_BUFFER_ALIGNMENT
    int "DMA buffer alignment in bytes (power of two)"
    default 4
    range 4 4096

config BUZZER
    bool "Board buzzer on PWM0 channel 1"
    depends on PWM && BOARD_DUST_HPM5E31
    default n

config BOARD_OUTPUTS
    bool "Board LEDs, buzzer and IMU heater"
    depends on PWM && GPIO
    default n

config IMU_HEATER_ENABLE
    bool "Enable IMU heater output (requires bench tuning)"
    depends on BOARD_OUTPUTS
    default n

config IMU_TARGET_C
    int "IMU target temperature in Celsius"
    default 45
    range 25 50

config IMU_HEATER_PERIOD_MS
    int "Heater PID control period in milliseconds"
    default 10
    range 1 1000
    help
      Period of the temperature control loop; 10 ms is 100 Hz.

config IMU_HEATER_KP_MILLI
    int "Heater proportional gain, multiplied by 1000"
    default 100
    range 0 1000

config IMU_HEATER_KI_MILLI
    int "Heater integral gain, multiplied by 1000"
    default 5
    range 0 1000

config IMU_HEATER_KD_MILLI
    int "Heater derivative gain, multiplied by 1000"
    default 0
    range 0 1000

config IMU_HEATER_MAX_PERMILLE
    int "Maximum heater duty in permille"
    default 1000
    range 0 1000

config ECAT_UART_RX_DMA_BYTES
    int "UART receive DMA buffer size"
    default 128
    range 64 512

config ECAT_UART2_IDLE_US
    int "UART2 receive idle threshold in microseconds"
    default 80
    range 20 200

config ECAT_SOURCE_ARRIVAL_STATS
    bool "Collect source arrival intervals for external acceptance"
    depends on MCAN_HPMICRO && ONBOARD_IMU_RAW
    select HPM_MCAN_RX_TIMING
    default n
    help
      Opt-in CAN SOF/callback and IMU DRDY/DMA-completion arrival statistics.
      Freeze before Stop protection traffic and report only after stopping.
      Disabled builds contain no collection or reporting hot path.

config ECAT_CAN_ISOLATION
    bool "Isolate wheel CAN buses for matched host acceptance"
    depends on MCAN_HPMICRO
    default n
    help
      DTG2 test profile: right wheel CAN1, left wheel CAN2, joints CAN0/CAN3.
      Requires matching wiring, protection configuration and host profile.
