/ { aliases {
    dust-can-0 = &mcan0; dust-can-1 = &mcan1;
    dust-can-2 = &mcan2; dust-can-3 = &mcan3;
    dust-uart-1 = &uart1; dust-uart-2 = &uart2;
    dust-uart-3 = &uart3; dust-uart-4 = &uart4;
    dust-uart-5 = &uart5; dust-uart-6 = &uart6;
}; };

/* HI91 实机使用 921600 baud；通用板级默认值保持不变。 */
&uart2 {
    current-speed = <921600>;
};

/* XDMA 0..5 belong to UART4..6; channel 6 is reserved for optional ESC DMA. */
/ { zephyr,user {
    dmas = <&xdma 6 0>;
    dma-names = "esc";
}; };
