@@ -320,6 +320,13 @@ const struct device *riscv_plic_get_dev(void)
 	return save_dev;
 }
 
+#if defined(CONFIG_DUST_ECAT_DC_SYNC)
+/* RAM diagnostics for the single-hart DC lab; no logging in interrupt context. */
+struct {
+	uint32_t version, entries, empty, valid, invalid, last_claim, last_valid, reserved;
+} dust_plic_claim_stats = {1, 0, 0, 0, 0, 0, 0, 0};
+#endif
+
 static void plic_irq_handler(const struct device *dev)
 {
 	const struct plic_config *config = dev->config;
@@ -330,6 +337,32 @@ static void plic_irq_handler(const struct device *dev)
 	/* Get the IRQ number generating the interrupt */
 	const uint32_t local_irq = sys_read32(claim_complete_addr);
 
+#if defined(CONFIG_DUST_ECAT_DC_SYNC)
+	++dust_plic_claim_stats.entries;
+	dust_plic_claim_stats.last_claim = local_irq;
+#endif
+	/* PLIC spec: claim 0 means no interrupt is pending. There is no
+	 * claimed source to dispatch or complete, even after notification.
+	 */
+	if (local_irq == 0U) {
+#if defined(CONFIG_DUST_ECAT_DC_SYNC)
+		++dust_plic_claim_stats.empty;
+#endif
+		return;
+	}
+	/* Check before indexing either statistics or the handler table. */
+	if (local_irq >= config->num_irqs) {
+#if defined(CONFIG_DUST_ECAT_DC_SYNC)
+		++dust_plic_claim_stats.invalid;
+#endif
+		z_irq_spurious(NULL);
+	}
+#if defined(CONFIG_DUST_ECAT_DC_SYNC)
+	++dust_plic_claim_stats.valid;
+	dust_plic_claim_stats.last_valid = local_irq;
+#endif
+
+
