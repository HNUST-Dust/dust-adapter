include_guard(GLOBAL)
get_filename_component(DUST_ADAPTER_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(DUST_WORKSPACE_ROOT "${DUST_ADAPTER_ROOT}/.." ABSOLUTE)
set(DUST_HPM_SUPPORT_DIR "${DUST_WORKSPACE_ROOT}/hpm_support" CACHE PATH "HPM Zephyr board/driver dependency")
# 可选的 HPM 板级支持；使用其他平台时不强制安装此依赖。
if(EXISTS "${DUST_HPM_SUPPORT_DIR}/zephyr/module.yml")
  list(APPEND BOARD_ROOT ${DUST_HPM_SUPPORT_DIR})
endif()
if(NOT DEFINED HPM_SDK_DIR AND DEFINED ENV{HPM_SDK_DIR})
  set(HPM_SDK_DIR "$ENV{HPM_SDK_DIR}" CACHE PATH "HPM SDK")
endif()
if(NOT DEFINED HPM_SDK_DIR AND EXISTS "${DUST_WORKSPACE_ROOT}/sdk_env/hpm_sdk/cmake/cmake-ext.cmake")
  set(HPM_SDK_DIR "${DUST_WORKSPACE_ROOT}/sdk_env/hpm_sdk" CACHE PATH "HPM SDK")
endif()
